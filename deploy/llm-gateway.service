[Unit]
Description=LLM Gateway (Go) - pooled routing, identity, cost accounting
After=network.target

[Service]
Type=simple
User=llmgateway
WorkingDirectory=/opt/llm-gateway
ExecStart=/opt/llm-gateway/bin/llm-gateway
Restart=always
RestartSec=3
Environment=LLM_GATEWAY_CONF=/opt/llm-gateway/llm_gateway.conf
Environment=PB_DATA_DIR=/var/lib/llm-gateway/pb

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-gateway

[Install]
WantedBy=multi-user.target
